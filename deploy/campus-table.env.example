# 서버의 /etc/campus-table.env 로 복사해서 값을 채운다 (권한 600, git에 올리지 않기).
# 따옴표 없이 KEY=value 형식. 비밀번호에 공백이 있으면 이 방식으로는 쓸 수 없다.

# --- 운영 프로파일 ---
SPRING_PROFILES_ACTIVE=prod
# 인증서 없이 HTTP로만 임시 운영할 때만 false (기본 true = 쿠키 Secure)
# COOKIE_SECURE=false
JAVA_OPTS=-Xms256m -Xmx768m

# --- DB / Redis ---
DB_URL=jdbc:mysql://<DB주소>:3306/campus_table?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# 인프라가 Redis의 notify-keyspace-events=Egx 를 켜 둬야 한다(prod 기본은 앱이 설정하지 않음)

# --- 최초 관리자 계정 (없을 때만 생성) ---
ADMIN_STUDENT_NUMBER=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- 초기 데이터: 첫 기동에만 true (식당이 없을 때 학식당/가게/메뉴 입력), 이후 false 또는 삭제 ---
SEED_ENABLED=true

# --- 프론트 주소(다른 도메인일 때만 필요, 콤마로 여러 개) ---
CORS_ALLOWED_ORIGINS=https://www.campus-table.kro.kr

# --- 메일 (운영은 MAIL_ENABLED=true) ---
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
SCHOOL_EMAIL_DOMAIN=dankook.ac.kr

# --- 토스 테스트 키 ---
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# --- 이미지 저장소 (Object Storage) ---
OBJECT_STORAGE_ENABLED=true
OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
OBJECT_STORAGE_REGION=kr-standard
OBJECT_STORAGE_BUCKET=campus-table-images
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# --- CLOVA 이미지 인원 추정 (없으면 해당 API만 503) ---
CLOVA_API_KEY=
