# --- DB / Redis ---
DB_URL=jdbc:mysql://localhost:3306/campus_table?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- CORS (콤마로 여러 개 가능) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- 이메일 인증 (Gmail SMTP 앱 비밀번호) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
SCHOOL_EMAIL_DOMAIN=dankook.ac.kr
# false면 메일을 보내지 않고 인증 코드를 서버 로그에 출력 (로컬 개발용)
MAIL_ENABLED=true

# --- 토스페이먼츠 (개발자센터 > API 키 > 테스트) ---
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# --- 관리자 계정 (기동 시 없으면 생성) ---
ADMIN_STUDENT_NUMBER=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- NAVER Cloud Object Storage (설정 후 enabled=true) ---
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
OBJECT_STORAGE_REGION=kr-standard
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# 공개 읽기가 가능한 버킷/이미지 경로 또는 CDN의 기본 URL (끝 / 생략)
# 비워두면 endpoint/bucket 사용
OBJECT_STORAGE_PUBLIC_BASE_URL=

# --- CLOVA 이미지 인원 추정 ---
CLOVA_API_KEY=
CLOVA_ENDPOINT=https://clovastudio.stream.ntruss.com/v3/chat-completions/HCX-005
CLOVA_TIMEOUT_SECONDS=60
OCCUPANCY_SNAPSHOT_MAX_AGE_SECONDS=300

# --- 초기 데이터 ---
# true면 식당이 하나도 없을 때만 seed.sql(가게 9개, 메뉴 93개)을 기동 시 입력
SEED_ENABLED=false
